# default local path (postgres on :5432):
DATABASE_URL=postgresql://atharva@localhost:5432/privacyradar

# docker alternative (compose maps postgres to localhost:5433):
# DATABASE_URL=postgresql://privacyradar:privacyradar@localhost:5433/privacyradar

# redis (job queue)
REDIS_URL=redis://localhost:6379/0

# openai: only used when a policy hash actually changes
OPENAI_API_KEY=
OPENAI_EXTRACT_MODEL=gpt-4.1-mini
OPENAI_HARD_MODEL=gpt-5.6

# worker
CRAWL_USER_AGENT=privacyradar/0.1 (+https://privacyradar.local; research crawler)
CRAWL_DELAY_SECONDS=2
PLAYWRIGHT_FALLBACK=false

# optional: only for the 10% of pages that return empty html
FIRECRAWL_API_KEY=
